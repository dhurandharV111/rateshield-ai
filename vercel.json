{
  "crons": [
    { "path": "/api/fed-brief", "schedule": "0 11 * * *" }
  ],
  "rewrites": [
    {
      "source": "/api/chat",
      "destination": "/api/chat.js"
    },
    {
      "source": "/api/fred",
      "destination": "/api/fred.js"
    },
    {
      "source": "/api/fed-brief",
      "destination": "/api/fed-brief.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
