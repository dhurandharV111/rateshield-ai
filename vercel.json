{
  "crons": [
    {
      "path": "/api/fed-brief",
      "schedule": "0 11 * * *"
    }
  ],
  "functions": {
    "api/fed-brief.js": {
      "includeFiles": "index.html"
    },
    "api/consensus.js": {
      "includeFiles": "index.html"
    }
  },
  "rewrites": [
    {
      "source": "/api/chat",
      "destination": "/api/chat.js"
    },
    {
      "source": "/api/fred",
      "destination": "/api/fred.js"
    },
    {
      "source": "/api/fed-brief",
      "destination": "/api/fed-brief.js"
    },
    {
      "source": "/api/consensus",
      "destination": "/api/consensus.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
